# ====== Bien moi truong cho Du an 3: Website Quang ba San pham (WordPress) ======
# Copy file nay thanh .env roi dien gia tri that:  cp .env.example .env

# IP cua may Ubuntu VM (dung lenh: ip a  de xem). Vi du: 192.168.195.129
VM_HOST_IP=192.168.195.129

# Ten mien/local domain dung trong /etc/hosts (vi du: wordpress.local)
SITE_DOMAIN=wordpress.local

# ====== MySQL ======
MYSQL_ROOT_PASSWORD=ChangeMe_Root_2026
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
MYSQL_PASSWORD=ChangeMe_Wp_2026

# ====== phpMyAdmin ======
PMA_HOST=db
PMA_PORT=3306
PMA_USER=root
PMA_PASSWORD=ChangeMe_Root_2026

# ====== WordPress ======
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD=ChangeMe_Wp_2026
# Table prefix (khong dung mac dinh wp_ de tang bao mat)
WORDPRESS_TABLE_PREFIX=wp_

# ====== Grafana ======
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=ChangeMe_Grafana_2026
GF_USERS_ALLOW_SIGN_UP=false

# ====== MySQL Exporter ======
# Tai khoan rieng chi co quyen SELECT de thu thap metric (khong dung root)
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=ChangeMe_Exporter_2026
